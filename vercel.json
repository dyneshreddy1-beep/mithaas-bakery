{
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "backend/*env/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
