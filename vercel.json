{
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    },
    "**/*": {
      "excludeFiles": ".lovable/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
